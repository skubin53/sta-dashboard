<!-- STA form_submit, same shape as the switchtoamerica.com sites. Added 2026-08-09. -->
<script>
window.dataLayer = window.dataLayer || [];
(function(){
if(window.__staFormTracker) return; window.__staFormTracker = 1;
function rnd(){return 'lead_'+Date.now()+'_'+Math.random().toString(36).substring(2,10);}
function digits(v){return (v||'').replace(/\D/g,'');}
async function eid(k){if(!k)return rnd();var s=k+'|'+new Date().toISOString().slice(0,10)+'|sta-lead';
var b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));
return 'lead_'+Array.from(new Uint8Array(b)).map(function(x){return x.toString(16).padStart(2,'0');}).join('').substring(0,32);}
function fields(f){return {
 em:f.querySelector('input[type="email"],input[name*="email" i]'),
 ph:f.querySelector('input[type="tel"],input[name*="phone" i]'),
 fn:f.querySelector('input[name*="first" i],input[placeholder*="first" i]'),
 ln:f.querySelector('input[name*="last" i],input[placeholder*="last" i]')};}
function key(x){var e=x.em&&x.em.value?x.em.value.trim().toLowerCase():'';if(e)return e;
var p=digits(x.ph&&x.ph.value);return p?'p:'+p:'';}
function attach(){document.querySelectorAll('form').forEach(function(f){
 if(f.dataset.staTracked==='1')return; f.dataset.staTracked='1';
 var h=f.querySelector('input[name="sta_event_id"]');
 if(!h){h=document.createElement('input');h.type='hidden';h.name='sta_event_id';f.appendChild(h);}
 var x=fields(f);
 var up=async function(){try{h.value=await eid(key(x));}catch(e){}};
 [x.em,x.ph].forEach(function(el){if(el){el.addEventListener('input',up);el.addEventListener('blur',up);el.addEventListener('change',up);}});
 f.addEventListener('submit',function(){var y=fields(f);
  window.dataLayer.push({event:'form_submit',event_id:h.value||rnd(),lead_value:2.20,currency:'CAD',
   user_data:{email:y.em&&y.em.value?y.em.value.trim().toLowerCase():'',phone:digits(y.ph&&y.ph.value),
   first_name:y.fn&&y.fn.value?y.fn.value.trim().toLowerCase():'',last_name:y.ln&&y.ln.value?y.ln.value.trim().toLowerCase():''},
   page_path:location.pathname});});});}
function init(){attach();new MutationObserver(attach).observe(document.body,{childList:true,subtree:true});}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
})();
</script>
<!-- END STA form_submit -->

<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Your Toxic Home Scan Results &middot; Switch to America</title>
<meta name="robots" content="noindex,nofollow">
<style>
:root{--bg:#0a0e14;--panel:#121a24;--panel2:#0f1620;--line:#22303f;--ink:#eef3f8;--mut:#93a4b5;
--teal:#2dd4bf;--teal2:#22d3ee;--orange:#ff9f1c;--orange2:#ffb347;--good:#34d399;--warn:#f87171;--amber:#fbbf24;
--navy:#0e2240;--red:#c8102e;--gold:#c8a24a;--green:#34d399;--cream:#0a0e14}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased;color:var(--ink);background:var(--bg);line-height:1.55}
.wrap{max-width:560px;margin:0 auto;padding:0 16px 60px}
img{max-width:100%;display:block}
.top{text-align:center;padding:26px 6px 4px}
.top .greet{font-size:15px;color:var(--mut)}
.top .greet b{color:var(--teal2)}
.scorewrap{background:linear-gradient(180deg,#16202c,#0e151d);border:1px solid var(--line);margin:14px 0 0;border-radius:18px;padding:26px 20px 22px;text-align:center;color:var(--ink);box-shadow:0 0 0 1px rgba(45,212,191,.18),0 18px 50px -18px rgba(34,211,238,.35)}
.flagged{font-size:12px;letter-spacing:.14em;color:var(--teal);font-weight:800;text-transform:uppercase}
.flagged .n{display:block;font-size:60px;font-weight:800;line-height:1;margin:8px 0 2px;color:var(--amber);letter-spacing:-.02em;text-transform:none;text-shadow:0 0 34px rgba(251,191,36,.35)}
.flagged .l{display:block;font-size:14.5px;font-weight:600;color:var(--mut);letter-spacing:0;text-transform:none}
.scorewrap p{font-size:14.5px;color:var(--mut);max-width:380px;margin:14px auto 0;line-height:1.6}
.found{margin:26px 0 0}
.found h3{font-size:12px;letter-spacing:.14em;color:var(--teal);text-transform:uppercase;font-weight:800;margin-bottom:10px}
.pcard{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--warn);border-radius:0 14px 14px 0;padding:15px 16px;margin-bottom:14px}
.pcard .name{font-weight:800;font-size:16px;color:var(--ink);margin-bottom:4px}
.pcard .ing{font-size:12.5px;color:var(--mut);margin-bottom:8px;line-height:1.5;white-space:pre-line}
.pcard p{font-size:13.5px;color:#c6d3e0;line-height:1.6;white-space:pre-line}
.pcard .n{font-size:13px;color:var(--good);font-weight:700;margin-top:9px}
.locked{background:var(--panel2);border:1px dashed rgba(255,159,28,.45);border-radius:14px;padding:18px 16px;text-align:center;margin-bottom:6px}
.locked .lk{font-size:22px;margin-bottom:6px;opacity:.9}
.locked h4{font-size:15.5px;color:var(--orange2);font-weight:800;margin-bottom:6px}
.locked p{font-size:13px;color:var(--mut);line-height:1.6}
.mirror{background:linear-gradient(180deg,#111a26,#0c1119);border:1px solid var(--line);border-radius:18px;padding:22px 20px;margin:26px 0 0;color:var(--ink)}
.mirror h3{font-size:19px;font-weight:800;text-align:center;margin-bottom:4px}
.mirror .sub{font-size:13.5px;color:var(--mut);text-align:center;margin-bottom:12px}
.mirror ul{list-style:none}
.mirror li{display:flex;gap:11px;align-items:flex-start;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:14.5px;color:#dbe6f0}
.mirror li:last-child{border-bottom:0}
.mirror .ic{flex:none;font-size:17px;line-height:1.3}
.mirror .kick{margin-top:14px;text-align:center;font-weight:800;font-size:15px;color:var(--amber);line-height:1.4}
.offer{margin:26px 0 0}
.oc{background:linear-gradient(180deg,#16202c,#0e151d);border:1px solid var(--line);border-radius:18px;padding:22px 20px;text-align:center;box-shadow:0 0 0 1px rgba(45,212,191,.2),0 18px 50px -14px rgba(34,211,238,.35)}
.oc .tag{display:inline-block;background:rgba(45,212,191,.12);border:1px solid rgba(45,212,191,.4);color:var(--teal);font-size:11px;font-weight:800;letter-spacing:.1em;padding:5px 12px;border-radius:999px}
.oc h2{font-size:23px;font-weight:800;color:var(--ink);margin:12px 0 4px;letter-spacing:-.01em}
.oc .anchor{font-size:13.5px;color:var(--mut);line-height:1.55}
.oc .price{font-size:46px;font-weight:800;color:var(--ink);margin:14px 0 2px;letter-spacing:-.02em}
.oc .price small{display:block;font-size:12.5px;font-weight:600;color:var(--mut);letter-spacing:0;margin-top:2px}
.stack{list-style:none;text-align:left;margin:14px 0 4px}
.stack li{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#dbe6f0;padding:7px 0}
.stack .ck{flex:none;color:var(--teal2);font-weight:800}
.btn{display:block;width:100%;text-decoration:none;background:linear-gradient(90deg,var(--orange),var(--orange2));color:#20140a;font-weight:800;font-size:17px;padding:17px 14px;border-radius:14px;margin:16px 0 6px;box-shadow:0 10px 30px -6px rgba(255,159,28,.55),0 0 0 1px rgba(255,159,28,.35) inset}
.urgency{font-size:12.5px;color:var(--amber);font-weight:700;margin-top:10px}
.guar{display:flex;gap:11px;align-items:flex-start;text-align:left;background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px 13px;margin-top:14px;font-size:12.5px;color:var(--mut);line-height:1.55}
.guar b{color:var(--ink)}
/* ---- sticky buy bar + objections (Hunter's devices, v3) ------------------------------
   His offer repeats five times down the page. Hers appeared twice, and after the founder
   block there was nothing to click for two screens. The bar makes the offer reachable at
   every scroll position without adding a word. */
.stick{position:fixed;left:0;right:0;bottom:0;z-index:60;transform:translateY(110%);
  transition:transform .28s ease;background:rgba(10,14,20,.96);border-top:1px solid var(--line);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  padding:10px 14px calc(10px + env(safe-area-inset-bottom))}
.stick.on{transform:translateY(0)}
.stick .in{max-width:520px;margin:0 auto;display:flex;align-items:center;gap:12px}
.stick .t{flex:1;min-width:0}
.stick .t b{display:block;font-size:13.5px;color:var(--ink);line-height:1.25}
.stick .t span{font-size:11.5px;color:var(--mut)}
.stick a{flex:none;background:linear-gradient(90deg,var(--orange),var(--orange2));
  color:#20140a;font-weight:800;font-size:14.5px;text-decoration:none;padding:12px 18px;
  border-radius:11px;white-space:nowrap}
@media(prefers-reduced-motion:reduce){.stick{transition:none}}

.objs{margin:26px 0 0}
.objs h3{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--mut);text-align:center;margin-bottom:12px}
.obj{background:var(--panel2);border:1px solid var(--line);border-radius:12px;
  padding:14px 16px;margin-bottom:9px}
.obj b{display:block;font-size:14px;color:var(--ink);margin-bottom:5px}
.obj p{font-size:13.5px;color:#c6d3e0;line-height:1.6;margin:0}
/* ---- v2, the page was not selling (2 sales from 99 leads) ----------------------------
   The fixes, in order of how much they matter: show the product, move the proof above the
   button, make the anchor visible, name the reviewer, give the guarantee its own line. */
.shot{margin:0 0 18px;text-align:center}
.shot img{width:100%;max-width:290px;height:auto;display:inline-block;
  filter:drop-shadow(0 18px 34px rgba(0,0,0,.45))}
.shot .cap{font-size:12px;color:var(--mut);margin-top:6px}

.preproof{display:flex;align-items:center;justify-content:center;gap:11px;margin:0 0 14px}
.preproof .faces{display:flex}
.preproof .ph{width:32px;height:32px;border-radius:50%;border:2px solid var(--panel);
  margin-left:-10px;background-size:cover;background-position:center 18%}
.preproof .ph:first-child{margin-left:0}
.preproof .n{font-size:12.5px;color:var(--mut);text-align:left;line-height:1.35}
.preproof .n b{color:var(--ink)}

.oc .was{display:block;font-size:15px;color:var(--mut);text-decoration:line-through;
  font-weight:700;margin-bottom:-2px}
.oc .price .now{font-size:12px;color:var(--teal);font-weight:800;letter-spacing:.08em;
  display:block;text-transform:uppercase;margin-bottom:2px}

.gtee{background:rgba(52,211,153,.08);border:1px solid rgba(52,211,153,.3);
  border-radius:12px;padding:13px 15px;margin-top:13px;text-align:left}
.gtee b{color:var(--good);display:block;font-size:12px;letter-spacing:.06em;
  text-transform:uppercase;margin-bottom:4px}
.gtee span{font-size:13px;color:#cddae6;line-height:1.55}
/* ---- the foot, rebuilt on Hunter's shape (Shannon 2026-08-10) -------------------
   The two photos are base64 and they are shown in three places between them, so they
   are declared ONCE here as backgrounds. Pasting the data URI at each <img> put 78 KB
   on a page that is running paid traffic. */
.ph{display:block;background-size:cover;background-position:center 18%;flex:none;
  border:1px solid var(--line)}
.ph-gene{background-image:url(data:image/jpeg;base64,)}
.ph-shan{background-image:url(data:image/jpeg;base64,)}
.ph-meg{background-image:url(../testimonial-meg-ann.jpg)}

.revs{margin:30px 0 0}
.revs-h{font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--mut);text-align:center;margin-bottom:14px}
.rev{background:var(--panel2);border:1px solid var(--line);border-radius:14px;
  padding:16px 17px;margin-bottom:11px}
.rev .stars{color:#f5b301;letter-spacing:2px;font-size:14px;margin-bottom:8px}
.rev p{font-style:italic;font-size:14px;line-height:1.6;color:#e6ebf1;margin:0 0 11px}
.rev .who{display:flex;align-items:center;gap:9px;color:var(--mut);font-size:12.5px;
  font-weight:700}
.rev .who .ph{width:30px;height:30px;border-radius:50%}

.me2{display:flex;gap:16px;align-items:flex-start;margin:26px 0 0;
  background:linear-gradient(180deg,#111a26,#0c1119);border:1px solid var(--line);
  border-radius:18px;padding:20px}
.me2 .ph{width:104px;height:132px;border-radius:14px}
.me2 h3{font-size:18px;font-weight:800;color:var(--ink);margin:0 0 9px;letter-spacing:-.01em}
.me2 p{font-size:13.5px;line-height:1.62;color:#c3cbd4;margin:0 0 10px}
.me2 p.q{color:var(--teal);font-style:italic;font-weight:600;margin:0}
@media(max-width:520px){
  .me2{flex-direction:column;align-items:center;text-align:center}
  .me2 .ph{width:132px;height:152px}
}

.fin{margin:30px 0 0;text-align:center}
.fin h2{font-size:24px;font-weight:800;color:var(--ink);letter-spacing:-.015em;
  line-height:1.18;margin:0 auto 8px;max-width:15em}
.fin .lede{font-size:14px;color:var(--mut);line-height:1.6;margin:0 auto 18px;max-width:30em}
.fproof{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:16px}
.faces{display:flex}
.faces .ph{width:36px;height:36px;border-radius:50%;border:2px solid var(--panel);
  margin-left:-11px}
.faces .ph:first-child{margin-left:0}
.fproof .n{color:var(--mut);font-size:12.5px;text-align:left;line-height:1.35}
.fproof .n b{color:var(--ink)}









.alt{text-align:center;font-size:13.5px;color:var(--mut);margin:20px 0 0}
.alt a{color:var(--teal2);text-decoration:none;border-bottom:1px solid rgba(34,211,238,.4)}
.fine{text-align:center;font-size:11.5px;color:#5f7386;margin:18px 6px 0;line-height:1.55}
</style></head>
<body><div class="wrap">

  <div class="top"><div class="greet">Hi <b id="sr-name">there</b>, here&rsquo;s what I saw.</div></div>

  <div class="scorewrap">
    <div class="flagged">Products flagged in your home
      <span class="n" id="sr-count">3</span>
      <span class="l">Each one linked to a real, documented health concern</span>
    </div>
    <p>I&rsquo;m not here to scare you. Almost every one of these has an easy, affordable American-made swap. Here&rsquo;s exactly what I found, and the fix for each.</p>
  </div>

  <div class="found">
    <h3>&#128269; What we found in your home</h3>
    <div class="pcard" id="sr-card"></div>
    <div class="locked">
      <div class="lk">&#128274;</div>
      <h4 id="sr-locked">The rest of your list is in the report</h4>
      <p>The full list, every ingredient, and the clean American-made swap for each, is in your $7 room-by-room report.</p>
    </div>
  </div>

  <div class="mirror">
    <h3>Does any of this sound familiar?</h3>
    <div class="sub">Your scan just told us what&rsquo;s in your house.</div>
    <ul>
      <li><span class="ic">&#129504;</span><span>Brain fog and fatigue that never fully lifts</span></li>
      <li><span class="ic">&#128552;</span><span>Kids with skin issues, asthma, or allergies that don&rsquo;t go away</span></li>
      <li><span class="ic">&#128548;</span><span>Pain and inflammation no doctor can explain</span></li>
      <li><span class="ic">&#128704;</span><span>Hair thinning and hormones that feel off for no reason</span></li>
      <li><span class="ic">&#129461;</span><span>Knees and joints that hurt every time you move</span></li>
      <li><span class="ic">&#128138;</span><span>On prescription meds and wish you didn&rsquo;t have to be</span></li>
    </ul>
    <div class="kick">This isn&rsquo;t age related, this isn&rsquo;t hereditary. You, your kids, your pets, you are all being poisoned.</div>
  </div>

  <div class="offer">
    <div class="oc">
      <span class="tag">YOUR PERSONALIZED REPORT</span>

      <!-- She is being asked to buy something she has never seen. Hunter never does that:
           his phone in a pair of hands is the first thing your eye lands on. Same hands and
           same phone her cheat sheet page already uses, with her actual audit on screen. -->
      <div class="shot">
        <img src="../media/report-phone.webp"
             alt="A pair of hands holding a phone showing the Switch to America home audit, with flagged products and the clean swap for each">
        <div class="cap">This is your report. Every room, every product, every swap.</div>
      </div>
      <h2>Toxic Home Scan Results</h2>
      <div class="anchor">A home wellness consultant charges $150 to walk your house room by room. Your scan already did the work.</div>
      <div class="price"><span class="now">Today</span><span class="was">$150</span>$7<small>One-time. No subscription. Yours to keep.</small></div>
      <ul class="stack">
        <li><span class="ck">&#10003;</span> Every flagged product from your scan, rated and explained</li>
        <li><span class="ck">&#10003;</span> Exact brand-by-brand swaps, no research required</li>
        <li><span class="ck">&#10003;</span> Room-by-room action list so you know exactly where to start</li>
      </ul>
      <!-- Proof BEFORE the ask. All of it used to sit below the fold, after the button. -->
      <div class="preproof">
        <span class="faces"><span class="ph ph-meg"></span><span class="ph ph-gene"></span><span class="ph ph-shan"></span></span>
        <span class="n"><b>20,000+</b> families have<br>already made the switch</span>
      </div>

      <a class="btn" id="sr-buy" data-buy href="#">Get my report now &rarr; $7</a>
      <div class="urgency">&#9203; Your scan results are held for 48 hours. After that, it&rsquo;s a fresh scan.</div>
      <div class="gtee"><b>My promise</b><span>If your report doesn&rsquo;t show you at least <b>3 swaps that matter</b>, text me the word REFUND and I put the $7 back on your card. You keep the report. I am not going to argue with you over seven dollars.</span></div>
    </div>
  </div>

  <div class="revs">
    <div class="revs-h">Women who already did this</div>

    <div class="rev">
      <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      <p>&ldquo;I&rsquo;d had &lsquo;mystery&rsquo; headaches for 30 years. The formaldehyde
      and benzene in those scented plug-ins was the culprit. The headaches stopped within a
      month. At 64, I still can&rsquo;t believe it.&rdquo;</p>
      <div class="who"><span class="ph ph-gene" role="img" aria-label="Gene"></span> Gene &middot; Switch to America customer</div>
    </div>

    <div class="rev">
      <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      <p>&ldquo;I was tired of overpaying for basic household things that barely worked and
      were toxic AF. So I switched where we shopped. That was it. Literally.&rdquo;</p>
      <div class="who"><span class="ph ph-meg" role="img" aria-label="Meg Ann"></span> Meg Ann &middot; Mom of 3</div>
    </div>
  </div>

  <div class="me2">
    <span class="ph ph-shan" role="img" aria-label="Shannon Nicole, founder of Switch to America"></span>
    <div>
      <h3>Why I built this scan</h3>
      <p>I am Shannon Nicole. I have kept a non-toxic home for 34 years, and I have spent
      the last 15 of them as a health and nutrition coach working with women.</p>
      <p>I built this because nobody handed me a list. I worked it out one product at a
      time, I got plenty of it wrong first, and I spent money I did not have to spend
      doing it.</p>
      <p>Your report is the shortcut I never got. You do not have to fix your whole house.
      You have to start with one shelf.</p>
      <p class="q">You should not need a chemistry degree to buy dish soap.</p>
    </div>
  </div>

  <div class="objs">
    <h3>What women ask me before they buy</h3>

    <div class="obj">
      <b>I already know what to throw out.</b>
      <p>Then you are further along than most. This is not a list of what is bad, it is a
      list of what to buy instead, for the exact brands you just tapped, so you are not
      standing in an aisle at 9pm reading the back of a bottle.</p>
    </div>

    <div class="obj">
      <b>Is this just a list of your own products?</b>
      <p>The swaps are mine, yes. I am not going to pretend otherwise or send you to a
      company I do not stand behind. What is in the report that you cannot get anywhere
      else is what is actually in the products you already own, room by room, and which one
      to deal with first.</p>
    </div>

    <div class="obj">
      <b>Seven dollars for a list?</b>
      <p>A home wellness consultant charges $150 to walk your house and tell you this. Your
      scan already did the walking. And if it does not show you three swaps that matter, you
      text me REFUND and I put the $7 back.</p>
    </div>
  </div>

  <div class="fin">
