<script>
/* Wired 2026-07-29. Reads the visitor's real scan from localStorage and shows
   ONE flagged product in full, with the rest locked behind the $7 report.
   Product copy is Shannon's, lifted from the master audit. */
var STA_PRODUCTS = {"dish": {"cat": "DISH SOAP", "hook": "Your hands are in it every day, and every plate, glass and fork your family puts in their mouth is rinsed in it.", "swap": "✓  Switch to America dish soap, plant-based, rinses clean, no residue.", "whats": "A cancer-causing contaminant created during manufacturing that never has to appear on the label (1,4-dioxane). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). A preservative so allergenic that Europe banned it from leave-on products (methylisothiazolinone, or MIT). Preservatives that slowly give off formaldehyde inside the bottle (DMDM hydantoin, quaternium-15). Harsh foaming agents that strip the skin barrier on your hands (sodium laureth sulfate).", "why": "Your hands sit in this water every day, and every plate your family eats off is rinsed in it. The contaminant that forms while these soaps are being manufactured is classified by the EPA as likely to cause cancer in people, and it is linked in animal studies to tumors of the liver, gallbladder, lung and breast, but because it is a byproduct rather than an ingredient it never has to appear on the label, which is exactly why New York had to pass a law limiting how much of it a bottle can contain. Nobody gets sick from one sink of dishes, and that is the trap of this one. The cost is twenty years of washing three times a day, and it is a chain you can break this week by changing a single bottle."}, "allpurpose": {"cat": "ALL-PURPOSE + DISINFECTANT SPRAYS", "hook": "You spray it, your kids breathe the mist, and it settles on the counter where you make their food.", "swap": "✓  Switch to America botanical disinfectant, kitchen degreaser, and everyday all-purpose cleaner.", "whats": "Germ-killing agents that are a documented cause of asthma in nurses and cleaners, and that reduced fertility and caused birth defects in exposed lab mice (quaternary ammonium compounds, called quats: benzalkonium chloride and DDAC). A solvent that destroys red blood cells and damages the liver and kidneys at high exposure, regulated by the EPA as a hazardous air pollutant (2-butoxyethanol). Hormone-disrupting chemicals hidden in the word \"fragrance\" (phthalates). Ammonia.", "why": "You are breathing that mist, and so is whoever is standing in the kitchen with you. Researchers followed more than 6,000 people for over twenty years and found that women who cleaned regularly, at home or for a living, lost lung function at a rate the study authors compared to smoking twenty cigarettes a day over ten to twenty years. That study looked at cleaning products as a category rather than one ingredient. Separately, the germ-killing agents common in these sprays are an established cause of occupational asthma in nurses and cleaners, and in lab mice, breeding pairs exposed to those same germ-killers had fewer pregnancies, smaller litters and more neural tube birth defects, which is animal evidence rather than proof in people, but it is why researchers keep raising fertility as a question. Lungs do not get that ground back, so this is damage that accrues over decades of wiping counters, and changing what is in the spray bottle is something you can do this week."}, "bleach": {"cat": "ALL-PURPOSE + DISINFECTANT SPRAYS", "hook": "The smell that tells you it is working is the part your family is breathing.", "swap": "✓  Switch to America botanical disinfectant, kitchen degreaser, and everyday all-purpose cleaner.", "whats": "Chlorine bleach itself (sodium hypochlorite). The irritant gases it releases into a closed room as you clean (chlorine gas and chloramines). A likely carcinogen that forms in your air when bleach reacts with ordinary kitchen grime and scented cleaners (chloroform and other chlorinated byproducts). Mixed with ammonia or an acid cleaner, it produces toxic gas immediately.", "why": "That sting at the back of your throat is your lungs doing the filtering, in a closed bathroom, with the door shut. In a study of 607 women, using bleach at home was associated with roughly three times the odds of non-allergic asthma, and the odds ran higher still for asthma that first showed up in adulthood. In a separate study of more than 9,000 school children, kids whose parents cleaned with bleach had about 20% more flu and 35% more recurrent tonsillitis. Both are observational studies, so they show a link rather than proof of cause, and researchers have also measured chloroform and chloramines forming in indoor air during bleach cleaning. Weekly bleaching runs for decades, lung function you lose does not come back, and changing what is under your sink is a decision you can make this week."}, "laundry": {"cat": "LAUNDRY DETERGENT", "hook": "Your kids sleep in it for eight hours, then wear it for twelve more.", "swap": "✓  Switch to America concentrated laundry detergent + fabric conditioner. Wool dryer balls instead of dryer sheets.", "whats": "A carcinogen created during manufacturing that never appears on the label (1,4-dioxane). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). A surfactant that breaks down into a chemical that behaves like estrogen in the body, restricted across Europe (nonylphenol ethoxylates). A preservative that is one of the leading causes of allergic skin rash (methylisothiazolinone). Dyes engineered to stay stuck in the fabric so clothes look whiter under light (optical brighteners).", "why": "Your skin is pressed against this 24 hours a day, and skin absorbs. The hormone-disrupting chemicals carried in laundry fragrance are the same family researchers have linked to early puberty in girls, lower testosterone, fertility problems, and in some studies a higher risk of breast cancer, and the manufacturing carcinogen left behind in the bottle is one the EPA calls a likely human carcinogen and has associated with liver damage. Two or three loads a week for twenty years is not one exposure, it is thousands stacked on the same body, and you can change what goes in the machine this week."}, "babylaundry": {"cat": "LAUNDRY DETERGENT", "hook": "Every sleeper, sheet, and swaddle holds detergent residue against her skin all night, every night.", "swap": "✓  Switch to America concentrated laundry detergent + fabric conditioner. Wool dryer balls instead of dryer sheets.", "whats": "A carcinogen created during manufacturing that never appears on the label, now capped in New York State at 1 part per million because of the cancer risk (1,4-dioxane). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). Chemicals bonded to the fibers on purpose so they glow white under light, which means they are built to survive the rinse (optical brighteners). Harsh detergents that strip the skin's protective layer (sodium lauryl sulfate and related surfactants). Softening chemicals linked to asthma in workplace studies (quaternary ammonium compounds, or quats).", "why": "Clothes and crib sheets touch your baby 24 hours a day, and detergent is engineered to leave part of itself behind in the fibers after the rinse. Researchers testing common household detergents on mouse skin and on human skin samples found the detergent broke down the skin's barrier and switched on inflammation, which matters because a damaged skin barrier in infancy is the leading explanation for how eczema leads to food allergy and then asthma. On top of that, the laureth-type surfactants used in many detergents carry a manufacturing contaminant the EPA calls likely to be carcinogenic to humans, and the fragrance carries hormone disruptors. Every load for years goes through the same box, so this is one purchase you can change this week."}, "stain": {"cat": "LAUNDRY DETERGENT", "hook": "You spray it on the collar, the exact spot that sits against your child's neck.", "swap": "✓  Switch to America concentrated laundry detergent + fabric conditioner. Wool dryer balls instead of dryer sheets.", "whats": "Solvents you breathe as a fine mist because this one is a spray, including one that damaged red blood cells and the liver in animal testing (2-butoxyethanol). A carcinogen created during manufacturing that never appears on the label (1,4-dioxane). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). Surfactants that break down into a chemical that behaves like estrogen in the body, restricted across Europe (nonylphenol ethoxylates). Dyes made to stay stuck in the fabric (optical brighteners).", "why": "You breathe the mist at close range while you are treating the shirt, and then the treated spot sits against skin for the rest of the day. Women who regularly used cleaning sprays at home showed faster lung function decline over 20 years in a large European study, and reviews of the research associate regular spray cleaning with higher rates of adult asthma. Fragrance in laundry products has repeatedly been found to carry hormone-disrupting phthalates, the ones researchers have linked to early puberty and fertility problems, with mixed results so far on breast cancer, and the contaminant left behind by manufacturing, 1,4-dioxane, is classified by the EPA as likely to cause cancer in people. Pretreating happens a few times a week for the entire time you are raising kids, so it stacks up quietly for decades, and swapping this one bottle is a change you can make this week."}, "deodorant": {"cat": "DEODORANT + ANTIPERSPIRANT", "hook": "It goes on warm, damp, covered skin an inch from your lymph nodes, and stays there sixteen hours a day.", "swap": "✓  Switch to America aluminum-free deodorant, or a clean magnesium-based deodorant.", "whats": "Hormone-mimicking preservatives that show up in human breast tissue (parabens), hormone-disrupting solvents hidden inside the word fragrance (phthalates), a metal salt that plugs your sweat ducts so you stop sweating (aluminum chlorohydrate), and in aerosol cans, a known cause of leukemia that comes from the propellant rather than the recipe (benzene).", "why": "This is one of the best absorbing patches of skin on your body, warm and covered all day, and you reapply to it every single morning without thinking. Researchers found one or more parabens, which act like weak estrogen in the body, in 99 percent of the human breast tissue samples they tested, and while that study could not say where the parabens came from, it did show they reach the tissue. In 2021 an independent lab found benzene, a known cause of leukemia, in aerosol antiperspirants, and Procter and Gamble pulled 17 Old Spice and Secret aerosol products off the shelves. Nobody can tell you what thirty or forty years of daily reapplication adds up to, and that uncertainty is exactly the reason to stop adding to it, which you can do this week."}, "coffee": {"cat": "COFFEE", "hook": "One ingredient. It is what comes with it that nobody prints on the can.", "swap": "✓  Mountain Cabin Coffee, ground or whole bean.", "whats": "<b>ONE INGREDIENT: coffee beans.</b> Nothing is added.\nThree things come with them anyway.\n• Acrylamide, created by the roasting itself\n• Glyphosate, sprayed on conventional fields\n• Mould toxins, from drying, storage and shipping", "why": "<b>WHAT THIS MEANS FOR YOU</b>\n• Pancreatic cancer\n• Neurological disorders\n• Reproductive and developmental issues\n• Stress on the liver\n• Cardiovascular toxicity\n\n<b>WHAT TESTING ACTUALLY FINDS</b>\n• 30 out of 30 supermarket ground coffees carried a measurable mould toxin.\n• 96 to 100% of green beans carry mould, and half of it grows inside the bean where washing cannot reach.\n\n<b>WHY EVERY SINGLE DAY IS THE PART THAT MATTERS</b>\n• Two or three cups a day is 730 to 1,095 cups a year. Over ten years, more than 10,000.\n• It takes about 35 days to clear your blood.\n• Nearly all of it binds to a blood protein your kidneys cannot filter out.\n• So the next cup lands long before the last one is gone.\n• The roasting byproduct showed up in 34 out of 34 coffee drinkers, and in 0 of 16 people who had skipped coffee for a month. That one takes seven months or more to leave.\n\n<b>This one switch could save your life.</b>", "tonight": "Finish the can you have. Just make the next one a coffee whose sourcing you actually know."}, "oil": {"cat": "BOTTLED COOKING OILS", "hook": "You cannot tell from the bottle whether you are cooking with what you paid for or with something that went bad before you opened it.", "swap": "✓  Grass-fed beef tallow, a whole, single-ingredient fat you can actually trust. Shelf-stable and built for high heat. Real butter for lower-heat cooking.", "whats": "Cheap oils quietly blended in and sold to you under a premium name (soybean and canola in bottles labeled avocado or extra virgin olive). Oil that has already gone rancid on the store shelf (oxidized fats and peroxides). Toxic breakdown products that form in the pan the moment a polyunsaturated oil hits high heat, which researchers describe as damaging to cells and DNA (aldehydes such as 4-hydroxynonenal, or HNE).", "why": "You are paying for a clean oil and, more often than not, cooking your family's dinner in something else. UC Davis researchers tested commercial avocado oil and found at least 82% of samples were rancid before their expiration date or cut with other oils, including three bottles labeled pure or extra virgin that were close to 100% soybean oil, and a separate UC Davis report found 73% of samples from the top-selling imported olive oil brands failed the international taste panels for extra virgin, for defects like rancidity and fermentation. Heating an oil high in polyunsaturated fat, especially over and over, generates aldehydes that researchers have shown in the lab to be cytotoxic and mutagenic, meaning they damage cells and DNA, and that kind of ongoing damage is what researchers point to when they connect these fats to chronic inflammation and artery disease. This is a small dose landing in dinner most nights for years rather than one bad meal, and the fat you cook in is a single swap you can make this week."}, "shampoo": {"cat": "SHOWER", "hook": "Hot water opens your scalp, and this runs down your face, neck and back for a full minute before it hits the drain.", "swap": "✓  Switch to America body wash + shampoo (paraben-free, no formaldehyde-releasers).", "whats": "A harsh foaming detergent made by a process that leaves a carcinogen behind (sodium laureth sulfate, contaminated with 1,4-dioxane), preservatives that work by slowly releasing formaldehyde into the bottle and onto your scalp (DMDM hydantoin, quaternium-15, imidazolidinyl urea), hormone-mimicking preservatives (parabens), and hormone-disrupting solvents hidden inside the single word fragrance (phthalates).", "why": "Check the back of your bottle for these preservative names, because the ones that keep shampoo from spoiling work by slowly releasing formaldehyde, and formaldehyde is classified by the World Health Organization's cancer agency as a known human carcinogen, based mostly on what it does to people who breathe it in day after day at work. A 2025 Silent Spring Institute study that tracked 70 Black and Latina women in Los Angeles found more than half were using at least one personal care product with those preservatives, most of them without knowing. Nobody has shown that one shampoo causes cancer, and one wash is a tiny dose. But this is a bottle you reach for most mornings for decades, and if you can get the same clean hair without it, there is no reason to keep the exposure."}, "bodywash": {"cat": "SHOWER", "hook": "It covers nearly every inch of skin you have, in hot water that opens your pores, every single day.", "swap": "✓  Switch to America body wash + shampoo (paraben-free, no formaldehyde-releasers).", "whats": "A harsh foaming detergent made by a process that leaves a carcinogen behind (sodium laureth sulfate, contaminated with 1,4-dioxane), preservatives that release formaldehyde a little at a time (DMDM hydantoin, quaternium-15), hormone-mimicking preservatives that turn up in human breast tissue (parabens), and hormone-disrupting solvents hidden inside the single word fragrance (phthalates).", "why": "You are spreading this over more skin at once than anything else in your house, every single day, in hot water. That is the whole problem with this one: it is not a strong product, it is a total-surface-area product. The preservatives that keep it from spoiling work by slowly releasing formaldehyde, which the World Health Organization's cancer agency classifies as a known human carcinogen based mostly on people who breathe it in at work, and the hormone-mimicking preservatives in the same bottle are the ones researchers keep studying for links to breast cancer, thyroid disease, infertility and early puberty in girls. Nobody has shown one shower does anything, and one shower is a tiny dose. This is a bottle you reach for most mornings for decades, and if you can get equally clean without it, there is no reason to keep the exposure."}, "babywash": {"cat": "KIDS’ SOAP + BUBBLE BATH", "hook": "Warm water opens the pores on the thinnest skin in your house, and the suds sit there for ten minutes every night.", "swap": "✓  Switch to America kids’ body wash + shampoo (gentle surfactants, no formaldehyde-releasers).", "whats": "Preservatives that work by slowly releasing formaldehyde into the bottle over its shelf life (quaternium-15, DMDM hydantoin). A carcinogen created during manufacturing that never has to appear on the label (1,4-dioxane). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). A skin sensitizer that dermatologists named allergen of the year in 2018 (propylene glycol). Harsh foaming agents that strip the skin's protective layer (sodium laureth sulfate).", "why": "Baby skin is thinner than yours and soaks up more of whatever sits on it, and a nightly bath turns this into a daily dose for years instead of a one-time exposure. The preservatives in these bottles slowly release formaldehyde, which the World Health Organization's cancer agency classifies as a known human carcinogen, mostly on the evidence from people who breathe it in at work. And University of Washington researchers found that babies whose parents had used lotion, powder or shampoo on them showed higher levels of phthalate breakdown products in their urine, with the youngest babies showing the strongest association. That study could not prove the products were the source, and it is one signal rather than a verdict, but it is years of quiet repeated exposure sitting in one bottle, and you can end it this week."}, "babylotion": {"cat": "KIDS’ SOAP + BUBBLE BATH", "hook": "Rubbed over your baby's whole body and left there. Nothing rinses it off.", "swap": "✓  Switch to America kids’ body wash + shampoo (gentle surfactants, no formaldehyde-releasers).", "whats": "Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). Preservatives that keep the bottle fresh by slowly releasing formaldehyde (DMDM hydantoin, quaternium-15). Hormone-mimicking preservatives that researchers have detected in human breast tissue samples (parabens). A skin sensitizer dermatologists named allergen of the year in 2018 (propylene glycol). A carcinogen created during manufacturing that never appears on the label (1,4-dioxane).", "why": "This one does not get rinsed off. It is rubbed over your baby's whole body and left there to absorb, on skin that is thinner than yours and takes up more of whatever sits on it. University of Washington researchers found that babies whose parents had used lotion, powder or shampoo on them had higher levels of phthalate breakdown products in their urine, with the youngest babies showing the strongest association. That study could not prove the products were the source, and it is one signal rather than a verdict. But the preservatives in these bottles release formaldehyde slowly over the shelf life, the manufacturing contaminant left in them is one the EPA classifies as likely to cause cancer in people, and this is happening every night for years. That is the part that adds up, and it is one bottle to change."}, "babypowder": {"cat": "KIDS’ SOAP + BUBBLE BATH", "hook": "A cloud of fine mineral dust puffed into the air right beside your baby's face, at every single diaper change.", "swap": "✓  Switch to America kids’ body wash + shampoo (gentle surfactants, no formaldehyde-releasers).", "whats": "A mined mineral dust that the World Health Organization's cancer agency reclassified in 2024 as probably carcinogenic to humans (talc). A known cancer-causing fiber that can contaminate it underground, because the two minerals form side by side in the same rock (asbestos). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates).", "why": "Every puff sends fine dust straight into the air your baby is breathing, and pediatricians have warned for decades that inhaled powder can cause serious lung injury in infants, with deaths reported in the medical literature. In 2024 the World Health Organization's cancer agency reclassified talc as probably carcinogenic to humans, pointing to ovarian cancer in women who reported using talc powder on the genital area for years, while noting the human evidence is limited and hard to separate from possible asbestos contamination. American juries have returned verdicts for plaintiffs who alleged Johnson & Johnson's baby powder caused their ovarian cancer or mesothelioma, though some of those verdicts have been reduced or overturned on appeal, and the company maintains its talc was asbestos free and did not cause disease. It stopped selling talc-based powder worldwide in 2023. The exposure here is not one bad day, it is fine dust breathed in and settled on skin thousands of times across the diaper years, and this is the easiest thing in the house to simply stop using this week."}, "babywipes": {"cat": "BABY WIPES", "hook": "Wiped across the most delicate skin on her body eight to ten times a day, and nothing rinses it off after.", "swap": "✓  Switch to America baby wipes, made for sensitive infant skin, no MIT, no phenoxyethanol.", "whats": "One of the strongest skin allergens dermatologists test for, still legal in American wipes even though several big brands have taken it out (methylisothiazolinone, or MIT). A preservative the FDA warned parents about in 2008, after infants exposed to a nipple cream that contained it alongside a second preservative showed slowed breathing, vomiting and diarrhea (phenoxyethanol). A skin sensitizer named allergen of the year in 2018 (propylene glycol). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). A carcinogen created during manufacturing that never appears on the label (1,4-dioxane).", "why": "This lands on the softest skin your child has, in a warm covered area, and nothing washes it off afterward. One of the preservatives still allowed in wipes here is such a strong allergen that dermatologists across Europe traced a wave of contact dermatitis to it and regulators there banned it from anything left on the skin, and once a child is sensitized that allergy tends to last for life, flaring again decades later from shampoos, sunscreens, and even wall paint. Used eight to ten times a day for two or three years, that is thousands of applications during the years the immune system is still deciding what to react to, and it is one of the easiest things in the house to change."}, "diaperash": {"cat": "TOPICAL MEDICINE", "hook": "Smeared onto raw, broken skin in the one place on her body that stays warm, damp, and covered all day.", "swap": "✓  Soap and water on clean minor cuts. Tallow balm for skin healing. Manuka honey for stubborn wounds. For rashes, find the root cause (detergent, body wash, food) first.", "whats": "A steroid that thins skin with repeated use and can make the rash rebound worse when you stop (hydrocortisone). One of the top three contact allergens in North American patch testing, named allergen of the year by the American Contact Dermatitis Society (neomycin). A second antibiotic that causes allergic contact dermatitis in long-term users (bacitracin). Plus, in many creams, added fragrance and preservatives on top of all of that.", "why": "Broken skin is not a barrier, so whatever goes on a raw diaper rash absorbs straight in, and a warm covered area holds it there for hours. Most diaper creams are simple zinc oxide. It is the two things parents reach for when zinc oxide is not working that deserve a second look. Triple antibiotic ointment contains neomycin, which dermatologists rank among the top three contact allergens in North America, so the ointment meant to calm the rash can be the reason it will not quit, and that allergy tends to be permanent once it starts. Hydrocortisone thins skin with repeated use, which is why the box says a few days and not a few weeks, and why anything longer belongs with your pediatrician rather than in a routine. What actually ends most of these rashes is finding the trigger, usually the detergent, the wipe, or the wash, and you can check all three this week. If the rash is blistering, bleeding, spreading, or still there after a few days, that is a call to the doctor, not a swap."}, "water": {"cat": "WHAT YOU DRINK + COOK WITH", "hook": "You drink it, cook with it, and mix your kids' drinks with it, all day, every day.", "swap": "✓  A reverse-osmosis system for drinking and cooking water. A carbon-filter pitcher as a minimum baseline.", "whats": "Forever chemicals that build up in your blood and do not leave on their own (PFAS). Cancer-linked byproducts formed when chlorine reacts with organic matter in the pipes (trihalomethanes). Chlorine and chloramines. Microplastics. In older homes, lead coming off the pipe between the street and your kitchen tap.", "why": "Water is the one exposure nobody in the house can skip, so whatever is in it goes into every person, every day, starting the day they are born. A 2023 US Geological Survey study estimated that at least one forever chemical is present in roughly 45% of US tap water, and the independent science panel that studied a heavily exposed community found probable links to kidney cancer, testicular cancer, thyroid disease and pregnancy-induced high blood pressure, while pooled studies of thousands of people have associated the chlorine byproducts in treated water with bladder cancer. Your body sheds these over years rather than days, so as long as the tap keeps running the level keeps building, and a filter on the water you drink and cook with is something you can have in place this week."}, "homeair": {"cat": "PLUG-IN AIR FRESHENERS", "hook": "It runs all night in the hallway outside your kids' bedrooms, and nobody turns it off.", "swap": "✓  A pure essential-oil diffuser with a single Switch to America essential oil. For background scent, baking soda + lemon rind in an open dish.", "whats": "Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). Scent chemicals that build up in body fat and have been detected in breast milk (synthetic musks). A cancer-causing gas that forms in the room when the scent oils react with ordinary indoor air (formaldehyde). A carcinogen created during manufacturing (1,4-dioxane). Propellants and solvents (isobutane). When a consumer group tested 14 air fresheners, 12 contained phthalates and not one listed them on the label.", "why": "This one runs while your family sleeps, eight to twelve hours a night, in a closed room, and nobody is choosing to breathe it. The hormone-disrupting chemicals that carry the scent have been linked in research to early puberty in girls and to reproductive problems in baby boys, and researchers have measured the scent oils reacting with ordinary indoor air to form formaldehyde, a known human carcinogen that health agencies say should be kept as low as you can get it indoors. A plug-in never pauses the way a spray does, so it is years of nonstop exposure in the rooms your kids sleep in, and it is also the easiest thing on this whole list to end. You can unplug it tonight."}, "dishwasher": {"cat": "DISHWASHER DETERGENT + RINSE AID", "hook": "The film that keeps your glasses spot free is still on them when your family drinks out of them.", "whats": "The film-forming agent that researchers found damaged human gut tissue at the exact concentration a dishwasher leaves behind (alcohol ethoxylates). A chlorine-releasing sanitizer (sodium dichloroisocyanurate). Water-softening polymers (polycarboxylates). Hormone-disrupting chemicals hidden in the word \"fragrance\" (phthalates). The rinse aid is engineered not to rinse off. That is how it stops water spots, and it is also how it ends up in your family.", "why": "The residue does not wash away. It dries onto the dish, and your family swallows a little of it at the next meal. Researchers at the Swiss Institute of Allergy and Asthma Research reported in the Journal of Allergy and Clinical Immunology that rinse aid residue, at dilutions in the range that stays behind on washed dishware, damaged the barrier layer of human gut cells grown in the lab, and when they tested the ingredients one at a time the film-forming agent was the one doing it. Their measurements came from commercial machines, which skip the extra rinse, so take it as a warning about what dries onto a dish rather than a verdict on your kitchen. That barrier is the wall that keeps what is in your gut out of your bloodstream, researchers associate a damaged barrier with chronic inflammation, food allergies and autoimmune disease, and this is three meals a day off those plates for years, which is why simply not refilling the rinse aid reservoir this week is worth more than it sounds."}, "fabric": {"cat": "FABRIC SOFTENER", "hook": "Softness is a film, left on purpose, on the pajamas your kids sleep in.", "whats": "Disinfectant-grade chemicals that coat the fibres and are designed not to wash out (quaternary ammonium compounds, mainly DDAC and ADBAC). Hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates). Preservatives that trigger allergic skin rash (methylisothiazolinone). There is no separate softening agent. The softness is the residue.", "why": "Your kids lie in this all night with their face against it, and the coating is the whole point of the product. Softeners work by leaving a cationic residue on the fibres so they feel slick, and that same broad family of chemicals, in its disinfectant forms, is documented as a cause of new-onset asthma in healthcare workers and cleaners who handle it daily. In laboratory mice, researchers reported fewer pregnancies, fewer pups per litter and neural tube birth defects after months of ordinary exposure to two of those disinfectant versions. The softening version in your bottle is a gentler relative, and nobody has run that study on it, which is exactly the problem: it goes into every load for years, a child can grow up sleeping in it every single night, and no one has shown that is safe. You can leave it out of the very next load."}, "dryer": {"cat": "DRYER SHEETS", "hook": "The heat turns the sheet into vapor, and that is what fills your laundry room.", "whats": "Fragrance chemicals painted onto a coated sheet that turn to vapor in the dryer's heat. University of Washington researchers measured more than 25 volatile chemicals coming out of real home dryer vents, including a chemical known to cause leukemia (benzene) and a second cancer-causing pollutant (acetaldehyde). Plus hormone-disrupting chemicals hidden inside the single word \"fragrance\" (phthalates) and the softening coating left behind on the fabric (quaternary ammonium compounds).", "why": "Your family breathes this in the room where you fold clothes, and then wears the coating that stays on the fabric all day. University of Washington researchers who sampled the dryer exhaust at two homes found more than 25 volatile chemicals coming out, among them benzene and acetaldehyde, two pollutants the EPA lists as hazardous air pollutants with no established safe level. The study did not measure how much of that reaches you, and no one has shown a dryer sheet causes disease, but benzene is an established cause of leukemia at higher exposures, and the lead researcher's point still lands: the same emissions coming out of a smokestack would be regulated, and coming out of your dryer vent they are not. Nobody runs one load, they run thousands over the years a family lives in a house, so the sheet is the fastest thing you can stop this week."}, "supplements": {"cat": "MULTIVITAMINS + SUPPLEMENTS", "hook": "You swallow the fillers right along with the vitamin, on an empty stomach, every morning of your life.", "whats": "A whitener Europe pulled out of the food supply because it could not be ruled safe for your DNA (titanium dioxide), a flow agent that has nothing to do with the nutrient (magnesium stearate), talc, hydrogenated oils, an artificial dye the FDA revoked in 2025 after it caused thyroid tumors in animals (Red No. 3), and synthetic forms your body handles differently than the ones in food.", "why": "You take this on an empty stomach every morning, which means the fillers get the exact same daily repetition the vitamin does. In 2022 the European Union pulled titanium dioxide out of food, supplements included, because its food safety authority could not rule out genotoxicity, meaning damage to your DNA, and it is still legal here, where the FDA does not review or approve supplements for safety before they reach the shelf. Nobody is checking what else ends up in the tub either. When Consumer Reports tested 23 protein powders and shakes in 2025, more than two thirds carried more lead in a single serving than its own experts consider safe for a whole day, and there is no federal limit for those products to break. Lead builds up in the body over years, so this is one bottle worth knowing everything about."}, "toothpaste": {"cat": "TOOTHPASTE", "hook": "It sits under your tongue twice a day, on tissue that absorbs faster than the skin on your arm.", "whats": "A whitener Europe pulled out of the food supply because regulators could not rule out DNA damage (titanium dioxide), a foaming detergent tied to mouth ulcers (sodium lauryl sulfate), artificial dyes including ones now being pulled from food, and artificial sweeteners.", "why": "Twice a day you put a whitening powder onto one of the most absorbent tissues in your body, and it is the same additive the European Union removed from all food in 2022 because its own scientists could not rule out genotoxicity, meaning damage to DNA. It is still perfectly legal in American toothpaste, and the foaming agent sitting next to it is tied in published systematic reviews to more frequent and more painful canker sores in people who get them. Your kids start this at age two and repeat it twice a day for eighty years, which is about as cumulative as an exposure gets, and it is one of the cheapest things in your house to change this week."}, "makeup": {"cat": "MAKEUP + COSMETICS", "hook": "It sits on your eyelids, lips and cheeks for twelve hours, and the part that makes it last never breaks down.", "whats": "Forever chemicals that do not leave your body or the environment and usually are not on the label (PFAS), a mineral the World Health Organization's cancer agency reclassified in 2024 as probably carcinogenic to humans (talc), hormone-disrupting solvents hidden inside the word fragrance (phthalates), and a whitener Europe removed from food over DNA-damage concerns (titanium dioxide).", "why": "What makes a foundation or mascara last all day is often a class of chemicals that barely breaks down, and a National Academies of Sciences panel has linked exposure to them with kidney cancer, testicular cancer, thyroid disease, high cholesterol and pregnancy complications including preeclampsia. Researchers at the University of Notre Dame tested more than 200 North American cosmetics and found the chemical marker for these in 82 percent of waterproof mascaras and 63 percent of foundations, and most of those products never listed them on the label. Your body clears them over years, not days, so the level in your blood climbs for as long as you keep applying and only starts coming back down once you stop, which you can do this week."}};
var STA_STRIPE = "https://sta-checkout.theshannonnicole.workers.dev/";

/* STA_PRODUCTS is keyed on the scan's own category slug (dish, laundry, oil...),
   so this is an exact lookup rather than fuzzy brand matching. */
function staLookup(cat){
  return (cat && STA_PRODUCTS[cat]) ? STA_PRODUCTS[cat] : null;
}

function staEsc(t){
  return String(t==null?"":t).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

/* Escape everything, then re-enable ONLY <b>, with no attributes. Same approach the paid
   report uses, so the two pages cannot drift. Nothing a scan payload carries can smuggle a
   tag through this. */
function staRich(t){
  return staEsc(t).split("&lt;b&gt;").join("<b>").split("&lt;/b&gt;").join("</b>");
}

(function(){
  var d = {};
  try { d = JSON.parse(localStorage.getItem("sta_scan") || "{}"); } catch(e){}
  var items = (d && d.items) || [];

  /* ?preview=1 renders a labelled sample so the page can be REVIEWED without completing a
     scan first. Shannon could not open her own sales page otherwise, because the guard
     below bounces anyone without a scan straight back to /now. This never fires for a real
     visitor: it needs the query string, and it does not write to localStorage, so a real
     scan started afterwards is completely unaffected. */
  if (!items.length && /[?&]preview=1/.test(location.search)) {
    d = {
      name: "Sample",
      score: 61,
      grade: "D",
      priority: "laundry",
      items: [
        { cat: "laundry",  brand: "Tide",        label: "Laundry detergent" },
        { cat: "dish",     brand: "Dawn",        label: "Dish soap" },
        { cat: "allpurpose", brand: "Pine-Sol",  label: "All purpose cleaner" },
        { cat: "coffee",   brand: "Folgers",     label: "Coffee" }
      ]
    };
    items = d.items;
    var pv = document.createElement("div");
    pv.setAttribute("style",
      "position:fixed;top:0;left:0;right:0;z-index:200;background:#7a1020;color:#fff;" +
      "font:600 12.5px/1.35 system-ui,sans-serif;text-align:center;padding:7px 12px");
    pv.textContent = "PREVIEW. Sample answers, not a real scan. Remove ?preview=1 to use the live page.";
    document.addEventListener("DOMContentLoaded", function () {
      document.body.appendChild(pv);
      document.body.style.paddingTop = "30px";
    });
  }

  /* no scan in this browser: send them back rather than show a fake result */
  if (!items.length){
    location.replace("https://scan.ismyhometoxic.com/now");
    return;
  }

  var nameEl = document.getElementById("sr-name");
  if (nameEl && d.name) nameEl.textContent = d.name;

  /* Show EVERY flagged product, not just the 12 we carry copy for. items[] is capped at
     12 for payload size, so reading items.length froze this number at 12 and it stopped
     climbing as people flagged more. d.total is the true uncapped count. Shannon 2026-08-05. */
  /* The bar carries her own number, not a placeholder, and only appears once the first
     button has scrolled away. Passive listener so it cannot cost scroll smoothness. */
  var bar = document.getElementById("stickbar");
  if (bar) {
    window.addEventListener("scroll", function () {
      if (window.scrollY > 600) bar.classList.add("on");
      else bar.classList.remove("on");
    }, { passive: true });
  }

  var cEl = document.getElementById("sr-count");
  var flaggedTotal = (typeof d.total === "number" && d.total > items.length) ? d.total : items.length;
  if (cEl) cEl.textContent = flaggedTotal;
  var barN = bar && bar.querySelector(".t span");
  if (barN) barN.textContent = flaggedTotal + " products flagged \u00b7 $7";

  /* Reveal up to THREE flagged products, spread across her scan instead of just the
     first one. The old code broke on the first match, and because the scan asks kitchen
     questions first, it always showed a kitchen item. Something she flagged later, like
     her coffee, could never surface. We now dedupe by category and spread the picks
     across the whole list so the reveal covers different parts of her house.
     Shannon 2026-08-05. */
  /* Rank by HOW IT GETS INTO THE BODY, strongest first. What she swallows beats what she
     sprays. This is why coffee now surfaces: the scan asks kitchen cleaners first, so in
     plain scan order a dish soap always won and the coffee she drinks every morning never
     appeared. */
  var RANK = {
    coffee:1, oil:1, water:1, supplements:1,                       /* swallowed daily */
    babywash:2, babylotion:2, babypowder:2, babywipes:2, babylaundry:2, diaperash:2,  /* on a baby */
    laundry:3, fabric:3, dryer:3, shampoo:3, bodywash:3, deodorant:3, toothpaste:3, makeup:3, /* on skin all day */
    homeair:4, allpurpose:4, bleach:4, dish:4, dishwasher:4, stain:4                  /* surfaces and air */
  };
  var candidates = [], seenCat = {};
  for (var i=0;i<items.length;i++){
    var c = items[i].cat;
    if (seenCat[c]) continue;
    var p = staLookup(c);
    if (p){ seenCat[c] = 1; candidates.push({ copy: p, item: items[i], rank: RANK[c] || 5, ord: i }); }
  }
  candidates.sort(function(a,b){ return (a.rank - b.rank) || (a.ord - b.ord); });
  /* Reveal exactly ONE product. The rest stays behind the $7, that is the whole offer.
     The ranking above still decides WHICH one, so the single reveal is her most
     personal hit (the coffee she drinks) instead of whatever the scan asked first. */
  var picks = candidates.slice(0, 1);
  if (!picks.length && items.length) picks = [{ copy: null, item: items[0] }];
  var pick = picks.length ? picks[0].copy : null;
  var picked = picks.length ? picks[0].item : items[0];

  var card = document.getElementById("sr-card");
  if (card){
    /* #sr-card becomes the container; each pick renders as its own .pcard inside it,
       reusing the same styling the single card used to have. */
    card.className = "";
    var html = "";
    for (var pi=0; pi<picks.length; pi++){
      var pc = picks[pi].copy, it = picks[pi].item;
      var brand = staEsc(it.brand || "");
      /* the swap comes from the scan itself, so it is always the real one */
      var swap = staEsc(it.target || "");
      var swapLine = swap ? '<div class="n">&#10003; Switch to ' + swap + '</div>' : '';
      var body = pc
        ? '<div class="ing">' + staRich(pc.whats || pc.cat) + '</div>' +
          '<p>' + staRich(pc.why || pc.hook) + '</p>'
        : '<div class="ing">' + staEsc(it.cat || "") + '</div>' +
          '<p>This one came up in your scan. The full ingredient breakdown, and why it ' +
          'matters for your family, is in your report.</p>';
      html += '<div class="pcard"><div class="name">&#128308; ' + brand + '</div>' + body + swapLine + '</div>';
    }
    card.innerHTML = html;
  }

  var lk = document.getElementById("sr-locked");
  if (lk){
    /* same uncapped total, so "+ N more flagged products" matches the headline number */
    var rest = flaggedTotal - picks.length;   /* we now reveal up to 3, not 1 */
    lk.textContent = rest > 0
      ? "+ " + rest + (rest === 1 ? " more flagged product" : " more flagged products") + " in your home"
      : "Your full room-by-room breakdown";
  }

  /* Stripe, carrying the report id so the paid page knows who they are */
  /* Both buy buttons, the one under the offer and the one at the foot. Bound by
     attribute rather than by id so the foot button runs the SAME code: if it skipped the
     hand-off below it would sell an audit with nobody's answers in it. */
  Array.prototype.forEach.call(document.querySelectorAll("[data-buy]"), function(buy){
    buy.addEventListener("click", async function(ev){
      ev.preventDefault();
      var rid = "";
      try { rid = localStorage.getItem("reportId") || ""; } catch(e){}
      try {
        if (window.fbq) fbq("track","InitiateCheckout",{value:7,currency:"USD",content_name:"Score Recovery Plan"});
        if (window.dataLayer) dataLayer.push({event:"tripwire_click",value:7,currency:"USD"});
      } catch(e){}
      var u = STA_STRIPE;
      if (rid) u += (u.indexOf("?") >= 0 ? "&" : "?") + "client_reference_id=" + encodeURIComponent(rid);
      // Hand her actual scan to the checkout domain first. localStorage does not cross
      // domains, so without this her answers are lost the moment she leaves this page and
      // the audit she pays for could not be personalized. Best effort: if it fails we
      // still send her to checkout rather than blocking the sale.
      try {
        var rr = await fetch("https://sta-checkout.theshannonnicole.workers.dev/report-save", {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ scan: d })
        });
        var rj = await rr.json();
        if (rj && rj.id) u += (u.indexOf("?") >= 0 ? "&" : "?") + "r=" + encodeURIComponent(rj.id);
      } catch (e) {}
      location.href = u;
    });
  });
})();
</script>
</body></html>